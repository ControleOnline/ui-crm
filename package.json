{
  "name": "@controleonline/ui-crm",
  "version": "1.0.28",
  "author": "ControleOnline",
  "description": "ControleOnline CRM Quasar UI Component",
  "license": "MIT",
  "main": "src/react/index.js",
  "scripts": {
    "test": "npm run test:crm-empty-state && npm run test:opportunity-status-filter && npm run test:general-settings && npm run test:opportunity-editor-references && npm run test:royalties-payable && npm run test:royalties-receivable && npm run test:income-statements && npm run test:seller-commissions && npm run test:proposal-product-selection",
    "test:crm-empty-state": "node --test src/tests/react/utils/opportunityEmptyState.test.js",
    "test:opportunity-status-filter": "node --test src/tests/react/utils/opportunityStatusFilter.test.cjs",
    "test:general-settings": "node --test src/tests/react/pages/settings/generalSettings.shared.test.js",
    "test:opportunity-editor-references": "node --test src/tests/react/utils/opportunityEditorReferences.test.js",
    "test:royalties-payable": "node --test src/tests/react/utils/royaltiesPayableParams.test.js",
    "test:royalties-receivable": "node --test src/tests/react/pages/royalties/royaltiesReceivableHelpers.test.js",
    "test:income-statements": "node --test src/tests/react/pages/comissions/incomeStatementsHelpers.test.js",
    "test:coverage": "c8 --reporter=clover --report-dir coverage npm test",
    "test:seller-commissions": "node --test src/tests/react/pages/comissions/sellerCommissionsHelpers.test.js",
    "test:proposal-product-selection": "node --test src/tests/react/utils/proposalProductSelection.test.js src/tests/react/utils/proposalCreateHelpers.test.js"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/controleonline/conline-quasar-ui"
  },
  "bugs": "",
  "homepage": "https://www.controleonline.com/devs/plugins",
  "browserslist": [
    "last 1 version, not dead, ie >= 11"
  ],
  "dependencies": {
    "@controleonline/ui-common": "*",
    "@controleonline/ui-default": "*",
    "@controleonline/ui-layout": "*",
    "@controleonline/ui-orders": "*",
    "@controleonline/ui-tasks": "*"
  }
}
